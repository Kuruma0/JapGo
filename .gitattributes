# Normalise line endings in the repository; check out native on Windows.
* text=auto

*.py   text diff=python
*.md   text
*.yaml text
*.yml  text
*.toml text

# Binary geodata should never be diffed or line-ending-converted.
*.las  binary
*.laz  binary
*.tif  binary
*.gpkg binary
*.parquet binary
*.pt   binary
*.onnx binary
